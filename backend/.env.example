# Postgres local (prototipo). Copia a .env y ajusta usuario/clave reales.
# En esta máquina el Postgres Docker suele estar en el puerto 5433.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=usuario
PGPASSWORD=contrasena
PGDATABASE=webpersonaltraining
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
TRAINER_SLUG=entrenador
SESSION_SECRET=cambia-este-secreto-de-sesion-local-32c
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME="Mario Vega"
DEMO_CLIENT_EMAIL=cliente@example.com
DEMO_CLIENT_PASSWORD=cambia-esta-clave
DEMO_CLIENT_NAME="Ana García"
