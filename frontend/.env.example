# Solo para builds de demo/staging. En producción déjalo ausente o en false.
# En `npm run dev` la precarga demo ya está activa.
VITE_DEMO_LOGIN=false

# Modo sin API/Postgres: datos en localStorage (GitHub Pages).
# VITE_DATA_MODE=local

# Base pública del sitio (GitHub Pages del repo).
# VITE_BASE=/WebPersonaltraining/

# Dominio público (sin barra final). Activa canonical y og:url.
# VITE_SITE_URL=https://josewalke.github.io/WebPersonaltraining
